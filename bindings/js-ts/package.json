{
  "name": "wardrobe-js-ts-bindings",
  "version": "0.26.725",
  "description": "Workspace for the Wardrobe client and embedded JavaScript/TypeScript bindings.",
  "private": true,
  "license": "MIT",
  "author": "Wardrobe Maintainers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/totalknowledge/wardrobe.git",
    "directory": "bindings/js-ts"
  },
  "homepage": "https://github.com/totalknowledge/wardrobe#readme",
  "bugs": {
    "url": "https://github.com/totalknowledge/wardrobe/issues"
  },
  "keywords": [
    "wardrobe",
    "database",
    "typescript",
    "javascript",
    "bindings"
  ],
  "workspaces": [
    "client",
    "embedded"
  ],
  "sideEffects": false,
  "scripts": {
    "fmt": "cargo fmt --manifest-path Cargo.toml --package wardrobe-js-ts -- --check",
    "clippy": "cargo clippy --manifest-path Cargo.toml --all-targets --all-features --no-deps -- -D warnings",
    "test": "cargo test --manifest-path Cargo.toml --all-targets --all-features",
    "pack:client:dry-run": "npm pack --dry-run --workspace=@wardrobe/client",
    "pack:embedded:dry-run": "npm pack --dry-run --workspace=@wardrobe/embedded",
    "publish:client:dry-run": "npm publish --dry-run --access public --workspace=@wardrobe/client",
    "publish:embedded:dry-run": "npm publish --dry-run --access public --workspace=@wardrobe/embedded",
    "publish:client": "npm publish --access public --workspace=@wardrobe/client",
    "publish:embedded": "npm publish --access public --workspace=@wardrobe/embedded"
  }
}
