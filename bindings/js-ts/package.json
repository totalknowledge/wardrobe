{
  "name": "@wardrobe/database",
  "version": "0.1.0",
  "description": "JavaScript and TypeScript package scaffold for Wardrobe database bindings.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Wardrobe Maintainers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/totalknowledge/wardrobe.git",
    "directory": "bindings/js-ts"
  },
  "homepage": "https://github.com/totalknowledge/wardrobe#readme",
  "bugs": {
    "url": "https://github.com/totalknowledge/wardrobe/issues"
  },
  "keywords": [
    "wardrobe",
    "database",
    "typescript",
    "javascript",
    "bindings"
  ],
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "Cargo.toml",
    "LICENSE",
    "README.md",
    "classify.js",
    "client/index.d.ts",
    "client/index.js",
    "client/package.json",
    "embedded/index.d.ts",
    "embedded/index.js",
    "embedded/package.json",
    "index.d.ts",
    "index.js",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "fmt": "cargo fmt --manifest-path Cargo.toml --package wardrobe-js-ts -- --check",
    "clippy": "cargo clippy --manifest-path Cargo.toml --all-targets --all-features --no-deps -- -D warnings",
    "test": "cargo test --manifest-path Cargo.toml --all-targets --all-features",
    "publish:dry-run": "npm publish --dry-run"
  }
}
